  },
  {
    "case_id": "capacity_multiple_direction_should_follow_dictionary",
    "category": "context_pack_understanding",
    "description": "recent_day_5h_peak_multiple=0.56 应理解为容量覆盖不足；burst_1h_estimated_5h_multiple=3.25 不应被机械判为越大越危险。",
    "input": {
      "input_mode": "synthetic_context",
      "user_message": "现在风险高不高，突发 1h 是不是很危险",
      "trigger": "manual_chat",
      "context_pack": {
        "schema_version": "agent_context_pack.v2",
        "run": {"trigger": "manual_chat", "user_message": "现在风险高不高，突发 1h 是不是很危险"},
        "target_pool": {"pool_id": "sub2api:test:5", "site_id": "test", "account_type": "pro"},
        "capacity_dictionary": {
          "recent_day_5h_peak_multiple": "容量覆盖最近一天 5h 峰值压力的倍数，小于 1 表示容量覆盖不了对应峰值需求。",
          "burst_1h_estimated_5h_multiple": "容量覆盖突发 1h 折算到 5h 的压力倍数，大于 1 通常表示当前容量可以覆盖该折算压力。"
        },
        "capacity": {
          "account_type": "pro",
          "active_account_count": 18,
          "reserve_account_count": 2,
          "recent_day_5h_peak_multiple": 0.56,
          "burst_1h_estimated_5h_multiple": 3.25,
          "burst_1h_trend": "rising",
          "burst_1h_trend_strength": "strong",
          "current_speed_days": 1.2
        },
        "operational_facts": {
          "facts": [
            "recent_day_5h_peak_multiple=0.56，低于 1，表示容量不足以覆盖最近 5h 峰值。",
            "burst_1h_estimated_5h_multiple=3.25，大于 1，表示当前容量可以覆盖突发 1h 折算压力。",
            "突发趋势 rising strong 需要继续观察，但不能只因 3.25 判为容量不足。"
          ],
          "risk_signals": [
            {"signal": "recent_peak_capacity_gap", "level": "high", "evidence": "recent_day_5h_peak_multiple=0.56"},
            {"signal": "burst_usage_rising", "level": "medium", "evidence": "trend=strong"}
          ],
          "data_gaps": []
        },
        "event_windows": {"detail_24h": {"items": []}, "summary_1h": {}, "summary_6h": {}, "summary_24h": {}, "summary_7d": {}, "notable_patterns": []},
        "probe": {},
        "recent_agent_decisions": [],
        "recent_conversation": [],
        "long_term_memory": {},
        "system_constraints": {"read_only": true},
        "data_quality": {}
      }
    },
    "expected": {
      "must_include": ["0.56", "不足", "3.25"],
      "must_not_include": ["3.25 越大越危险", "3.25x 低于 1", "3.25 表示容量不足", "burst_1h_estimated_5h_multiple=3.25 说明危险"],
      "decision_constraints": {"should_create_decision": true, "must_not_reference_target_active": true},
      "assertions": [
        {"name": "severity_not_healthy", "type": "json_path_in", "path": "decision.severity", "values": ["watch", "warning", "danger", "critical"]}
      ]
    },
    "scoring": {
      "min_score": 0.8,
      "critical_assertions": ["contains:不足", "not_contains:3.25 越大越危险", "not_contains:3.25 表示容量不足"]
    }
  },
