[
  {
    "case_id": "event_401_midday_burst_should_not_ask_if_clustered",
    "category": "event_window_reasoning",
    "description": "最近 24h 的 401 已经在 event_windows.summary_24h.clusters 中显示集中发生，Agent 不应再追问是否集中。",
    "input": {
      "input_mode": "synthetic_context",
      "user_message": "今天这个池子要不要补号",
      "trigger": "manual_chat",
      "context_pack": {
        "schema_version": "agent_context_pack.v2",
        "run": {"trigger": "manual_chat", "user_message": "今天这个池子要不要补号"},
        "target_pool": {"pool_id": "sub2api:test:5", "site_id": "test", "account_type": "pro"},
        "capacity_dictionary": {
          "recent_day_5h_peak_multiple": "小于 1 表示当前容量不足以覆盖最近一天 5h 峰值压力。",
          "burst_1h_estimated_5h_multiple": "大于 1 表示当前容量可以覆盖突发 1h 折算到 5h 的压力。"
        },
        "capacity": {
          "account_type": "pro",
          "active_account_count": 8,
          "reserve_account_count": 0,
          "recent_day_5h_peak_multiple": 0.72,
          "burst_1h_estimated_5h_multiple": 0.88,
          "current_speed_days": 0.8
        },
        "operational_facts": {
          "facts": [
            "最近 24h 出现 401 集中爆发，主要集中在中午 12:00-12:20。",
            "这批 401 更像批量账号失效或批量封禁，而不是均匀散点。"
          ],
          "risk_signals": [
            {"signal": "401_midday_burst", "level": "high", "evidence": "18 个 401 集中在 20 分钟内"}
          ],
          "data_gaps": []
        },
        "event_windows": {
          "detail_24h": {"window_hours": 24, "max_items": 80, "items": []},
          "summary_1h": {"window": "1h", "total_events": 0, "event_type_counts": {}},
          "summary_6h": {"window": "6h", "total_events": 18, "error_category_counts": {"401": 18}},
          "summary_24h": {
            "window": "24h",
            "total_events": 18,
            "error_category_counts": {"401": 18},
            "clusters": [
              {
                "cluster_type": "time_burst",
                "window_start": "2026-07-01T12:00:00+08:00",
                "window_end": "2026-07-01T12:20:00+08:00",
                "event_count": 18,
                "account_count": 18,
                "dominant_event_type": "authentication_error",
                "dominant_error_category": "401",
                "interpretation": "401 集中发生在中午同一时间段，更像批量失效。"
              }
            ]
          },
          "summary_7d": {"window": "7d", "total_events": 30, "error_category_counts": {"401": 24}},
          "notable_patterns": [
            "401 集中发生在中午 12:00-12:20，同一时间段批量失效特征明显。"
          ],
          "data_quality": {}
        },
        "probe": {},
        "recent_agent_decisions": [],
        "recent_conversation": [],
        "long_term_memory": {"pool_daily_summaries": [], "pool_weekly_summaries": [], "decision_reviews": [], "operator_feedback_summaries": [], "survival_patterns": []},
        "system_constraints": {"read_only": true},
        "data_quality": {}
      }
    },
    "expected": {
      "must_include": ["集中", "中午", "批量"],
      "must_not_include": ["是否集中发生", "是否集中在同一时间段", "是不是集中"],
      "decision_constraints": {"should_create_decision": true, "must_not_reference_target_active": true},
      "assertions": [
        {"name": "event_assessment_burst", "type": "json_path_equals", "path": "decision.event_assessment.has_recent_ban_burst", "value": true}
      ]
