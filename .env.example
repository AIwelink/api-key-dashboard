APP_NAME="API Key Admin Backend"
APP_ENV=development
APP_SECRET_KEY=change-me-in-production

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173

VITE_FRONTEND_HOST=127.0.0.1
VITE_FRONTEND_PORT=5173
VITE_API_BASE_URL=/api

# Option A: full connection URI
MONGODB_URI=

# Option B: split connection settings
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB=api_key_admin

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Feishu QR login (enterprise self-built application)
FEISHU_AUTH_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_AUTHORIZE_BASE_URL=https://accounts.feishu.cn
FEISHU_OPEN_API_BASE_URL=https://open.feishu.cn
FEISHU_REQUEST_TIMEOUT_SECONDS=8

INITIAL_OWNER_EMAIL=admin@example.com
INITIAL_OWNER_NAME=Admin
INITIAL_OWNER_PASSWORD=change-me

# Logging
# development: detailed request lifecycle logs; production: quieter and more suitable for concurrency.
LOG_PROFILE=development
LOG_LEVEL=DEBUG
LOG_DIR=logs
LOG_RETENTION_DAYS=14
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
LOG_REQUEST_BODY=false
LOG_SLOW_REQUEST_MS=1000

# Agent Level 1 LLM, OpenAI-compatible chat completions endpoint.
# Example base URL: https://your-proxy.example.com/v1
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LEVEL1_MODEL=
AGENT_LEVEL1_TEMPERATURE=0.2
AGENT_REQUEST_TIMEOUT_SECONDS=60
